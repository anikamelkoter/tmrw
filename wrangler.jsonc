{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tmrw",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {"binding": "DB", "database_name": "tmrw-db", "migrations_dir": "migrations"}
  ],
  "triggers": {"crons": ["17 3 * * *"]}
}
